---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'center' } = Astro.props;
---
<div class={align === 'center' ? 'text-center max-w-3xl mx-auto mb-12' : 'mb-12'}>
  {eyebrow && <p class="text-brand-400 text-sm font-semibold uppercase tracking-wider mb-3">{eyebrow}</p>}
  <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{title}</h2>
  {description && <p class="text-gray-400 text-lg">{description}</p>}
</div>