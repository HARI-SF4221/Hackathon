---
interface Props {
  title: string;
  description: string;
  icon?: string;
}
const { title, description, icon = 'spark' } = Astro.props;
---
<div class="glass rounded-xl p-6 hover:border-brand-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-500/10">
  <div class="w-12 h-12 rounded-lg gradient-bg flex items-center justify-center mb-4">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
  </div>
  <h3 class="text-xl font-semibold text-white mb-2">{title}</h3>
  <p class="text-gray-400">{description}</p>
</div>