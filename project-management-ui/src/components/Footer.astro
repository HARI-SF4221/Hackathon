---
const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/how-it-works', label: 'How It Works' },
      { href: '/pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '#', label: 'Careers' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '#', label: 'Documentation' },
      { href: '#', label: 'Blog' },
      { href: '#', label: 'Support' },
    ],
  },
];
---
<footer class="border-t border-ink-700/50 bg-ink-900/80 mt-20">
  <div class="container py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <div class="flex items-center gap-2 font-bold text-xl mb-4">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none">
          <defs>
            <linearGradient id="foot-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#8B5CF6"/>
              <stop offset="100%" stop-color="#3B82F6"/>
            </linearGradient>
          </defs>
          <rect width="32" height="32" rx="8" fill="url(#foot-grad)"/>
          <path d="M8 12L14 18L24 8" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="gradient-text">TaskFlow AI</span>
      </div>
      <p class="text-gray-400 text-sm mb-4">AI-first project management for modern teams.</p>
      <form class="flex gap-2">
        <label for="newsletter" class="sr-only">Email</label>
        <input id="newsletter" type="email" placeholder="you@company.com" class="flex-1 px-3 py-2 rounded-lg bg-ink-800 border border-ink-700 text-white text-sm focus:ring-2 focus:ring-brand-500" />
        <button class="btn-primary text-sm px-4 py-2">Join</button>
      </form>
    </div>
    {cols.map(col => (
      <div>
        <h3 class="font-semibold text-white mb-4">{col.title}</h3>
        <ul class="space-y-2">
          {col.links.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-ink-700/50 py-6">
    <div class="container flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-400">
      <p>© 2024 TaskFlow AI. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white">Privacy</a>
        <a href="#" class="hover:text-white">Terms</a>
        <a href="#" class="hover:text-white">Security</a>
      </div>
    </div>
  </div>
</footer>