---
const year = new Date().getFullYear();
---
<footer class="border-t border-ink-700/50 bg-ink-900/50 mt-20">
  <div class="container py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
      <div class="col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-8 h-8 text-brand-400" viewBox="0 0 32 32" fill="none">
            <defs>
              <linearGradient id="footerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#8B5CF6" />
                <stop offset="100%" stop-color="#3B82F6" />
              </linearGradient>
            </defs>
            <path d="M16 2 L4 9 L4 23 L16 30 L28 23 L28 9 Z" stroke="url(#footerGrad)" stroke-width="2" fill="none" />
            <circle cx="16" cy="16" r="4" fill="url(#footerGrad)" />
          </svg>
          <span class="text-lg font-bold text-white">Project Management Software</span>
        </div>
        <p class="text-gray-400 text-sm max-w-md mb-4">
          Insight capture, feature backlog, configurable scoring, roadmap and tasks — connected end to end.
        </p>
        <p class="text-xs text-gray-500">
          Built for <a href="/about" class="text-brand-400 hover:underline">BoldCreate Hackathon 2026</a>.
        </p>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4 text-sm">Product</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/features" class="text-gray-400 hover:text-white transition">Features</a></li>
          <li><a href="/how-it-works" class="text-gray-400 hover:text-white transition">How it works</a></li>
          <li><a href="/pricing" class="text-gray-400 hover:text-white transition">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-4 text-sm">Company</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-gray-400 hover:text-white transition">About</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-white transition">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-ink-700/50 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500">
        &copy; {year} BoldCreate Hackathon. Project Management Software.
      </p>
      <p class="text-xs text-gray-500">
        Stack: ASP.NET Core · React · PostgreSQL · SignalR · Syncfusion
      </p>
    </div>
  </div>
</footer>