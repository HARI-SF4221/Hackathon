---
interface Props {
  question: string;
}
const { question } = Astro.props;
---
<details class="group glass rounded-lg overflow-hidden">
  <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-ink-700/30 transition-colors">
    <h3 class="text-white font-medium pr-4">{question}</h3>
    <svg class="w-5 h-5 text-brand-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </summary>
  <div class="px-5 pb-5 text-gray-400">
    <slot />
  </div>
</details>