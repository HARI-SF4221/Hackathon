---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';

const groups = [
  {
    name: 'AI & Automation',
    items: [
      { title: 'AI Sprint Planner', description: 'Auto-generate sprint plans from high-level goals in seconds.' },
      { title: 'Smart Task Breakdown', description: 'Turn epics into actionable tasks with AI-powered decomposition.' },
      { title: 'Predictive Timelines', description: 'Forecast delivery dates based on team velocity and historical data.' },
      { title: 'Auto-prioritization', description: 'AI ranks tasks by impact, urgency, and dependencies.' },
    ],
  },
  {
    name: 'Collaboration',
    items: [
      { title: 'Real-time Updates', description: 'See changes instantly with live cursors and presence indicators.' },
      { title: 'Smart Comments', description: 'AI summarizes threads, suggests replies, and extracts action items.' },
      { title: '@Mentions & Assignments', description: 'Notify the right people with intelligent mention suggestions.' },
      { title: 'Activity Feed', description: 'Stay in the loop with a personalized, AI-filtered activity stream.' },
    ],
  },
  {
    name: 'Project Management',
    items: [
      { title: 'Kanban & List Views', description: 'Switch between views with smooth animations and saved filters.' },
      { title: 'Gantt Charts', description: 'Visualize timelines with drag-and-drop dependency management.' },
      { title: 'Custom Workflows', description: 'Build workflows that match your team with no-code automation.' },
      { title: 'Milestones & Goals', description: 'Track OKRs and project milestones in one unified dashboard.' },
    ],
  },
  {
    name: 'Integrations & Security',
    items: [
      { title: '100+ Integrations', description: 'Connect with GitHub, Slack, Figma, Linear, and more.' },
      { title: 'API & Webhooks', description: 'Build custom integrations with our robust developer API.' },
      { title: 'SSO & SCIM', description: 'Enterprise-grade authentication and user provisioning.' },
      { title: 'Audit Logs', description: 'Complete activity history for compliance and security.' },
    ],
  },
];
---
<BaseLayout title="Features — TaskFlow AI">
  <section class="container py-20">
    <SectionHeading
      eyebrow="Features"
      title="Everything you need to ship"
      description="12 powerful features, designed for AI-first teams."
    />
  </section>

  {groups.map((group, idx) => (
    <section class="container py-12">
      <h2 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
        <span class="w-2 h-8 rounded gradient-bg"></span>
        {group.name}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {group.items.map(item => <FeatureCard title={item.title} description={item.description} />)}
      </div>
    </section>
  ))}

  <CTA />
</BaseLayout>