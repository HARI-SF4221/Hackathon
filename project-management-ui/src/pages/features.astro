---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CTA from '../components/CTA.astro';

const groups = [
  {
    name: 'Insight & evidence',
    items: [
      { title: 'Insight intake (FR-1)', description: 'Record verbatim customer text, customer, segment, contract value, source channel, submitter and date. File unlinked; triage later.' },
      { title: 'Insight-to-feature linking (FR-2)', description: 'One insight to many features. Each feature shows the number of distinct customers and total contract value behind it.' },
      { title: 'Activity history (FR-11)', description: 'Every status change, reassignment and date change recorded with who and when, on a per-feature timeline.' },
    ],
  },
  {
    name: 'Feature backlog & scoring',
    items: [
      { title: 'Feature record (FR-3)', description: 'Title, problem, solution, area, status, owner, target release, effort, and score inputs.' },
      { title: 'Configurable scoring (FR-4)', description: 'RICE-style factors with editable weights. Re-ranks live on weight change. Formula and contribution visible, not black-boxed.' },
      { title: 'Bulk export', description: 'Export backlog, scoring inputs, roadmap and tasks to CSV for board updates and audits.' },
    ],
  },
  {
    name: 'Roadmap, board, tasks',
    items: [
      { title: 'Roadmap (FR-5)', description: 'Drag features across releases on a timeline. Dependent items flag conflicts rather than silently shifting.' },
      { title: 'Kanban (FR-6)', description: 'Configurable columns mapped to statuses, drag between them, WIP limits with visible warning when exceeded.' },
      { title: 'Tasks & dependencies (FR-7)', description: 'Tasks under features with start/end, percent complete, assignee, finish-to-start dependencies. Gantt view surfaces the critical path.' },
    ],
  },
  {
    name: 'Collaboration & platform',
    items: [
      { title: 'Realtime sync (FR-8)', description: 'Any create, move or edit propagates to all clients in under a second. Conflicting simultaneous edits resolved deterministically.' },
      { title: 'Background jobs (FR-9)', description: 'Score recalculation, search indexing, digest and notifications — at-least-once with idempotent handlers, survive restart.' },
      { title: 'Search & filter (FR-10)', description: 'Full-text across insights, features and tasks with structured filters that compose. Sub-second on the demo dataset.' },
      { title: 'Roles & permissions (FR-12)', description: 'Contributor, Product Manager, Viewer. Permissions enforced on the API, not just the UI.' },
    ],
  },
];
---
<BaseLayout title="Features — Project Management Software">
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="Functional requirements" title="Twelve requirements, four groups" subtitle="Everything listed here maps back to a numbered spec ID so the demo can be checked against the requirements." />

      <div class="space-y-16 mt-16">
        {groups.map(group => (
          <div>
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <span class="w-1.5 h-8 bg-gradient-to-b from-brand-500 to-accent rounded-full"></span>
              {group.name}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.items.map(item => <FeatureCard title={item.title} description={item.description} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>