---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const trustedBy = ['Productboard', 'Aha!', 'Linear', 'Notion', 'Jira', 'Asana'];

const features = [
  { title: 'Insight capture', description: 'Customer feedback, requests and pain points captured with source, customer, date and free text — attachable to one or more features.' },
  { title: 'Prioritization scoring', description: 'Configurable RICE-style scoring (reach, impact, confidence, effort) with every input visible and editable — no black-box numbers.' },
  { title: 'Roadmap with evidence', description: 'See exactly which customers asked for a feature and how much revenue they represent. The evidence trail that justifies priority.' },
];

const testimonials = [
  { quote: 'We finally stopped arguing about priority in meetings. The score and the customer evidence behind it do that for us.', author: 'Priya Subramanian', role: 'Product Manager, Acme' },
  { quote: 'Dragging features onto a release that already shows capacity and critical-path tasks changed our planning meetings completely.', author: 'Marcus Lindqvist', role: 'Engineering Lead, Globex' },
  { quote: 'Sales sees where a customer request landed. Support sees when it ships. That alone was worth the migration.', author: 'Hannah Okafor', role: 'Head of Product, Initech' },
];

const faqs = [
  { q: 'How is this different from Jira or Linear?', a: 'Those are execution trackers. This is the planning layer above them — insight capture, prioritization, roadmap, then tasks that hand off into execution.' },
  { q: 'Can a viewer see the roadmap without an account?', a: 'Read-only viewers can. Role-based permissions ensure they cannot mutate anything through the API either, not just the UI.' },
  { q: 'Does the prioritization score update live?', a: 'Yes. Adjust any factor weight and the whole backlog re-ranks instantly. The formula and each factor contribution stay visible on every feature.' },
  { q: 'How do dependencies work?', a: 'Tasks have finish-to-start dependencies. The dependency view shows the critical path and flags any task whose predecessor is late, before it slips the release.' },
  { q: 'Is there a public request portal?', a: 'Yes — customers can submit and upvote requests. Each request becomes an insight that flows through the same triage process.' },
];
---
<BaseLayout title="Project Management Software — Connect customer input to a roadmap">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="container py-20 sm:py-32 relative">
      <div class="max-w-4xl mx-auto text-center animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-400 text-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse-slow"></span>
          BoldCreate Hackathon 2026 — Requirements Spec
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          Connect customer input to a <span class="gradient-text">roadmap</span> to delivered work
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          Product planning that closes the loop between what customers ask for, what your team commits to, and what actually ships — instead of three disconnected tools and a spreadsheet.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/features" class="btn-primary">See the requirements</a>
          <a href="/how-it-works" class="btn-secondary">Read the demo flow</a>
        </div>
        <p class="text-sm text-gray-500">36-hour scope · Three personas · One trail of evidence</p>
      </div>
    </div>
  </section>

  <!-- Trusted by -->
  <section class="container py-12 border-y border-ink-700/50">
    <p class="text-center text-sm text-gray-500 uppercase tracking-wider mb-6">Aligned with the way modern PM teams already work</p>
    <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12">
      {trustedBy.map(name => (
        <span class="text-2xl font-bold text-gray-600 hover:text-gray-400 transition-colors">{name}</span>
      ))}
    </div>
  </section>

  <!-- Features highlights -->
  <section class="container py-20">
    <SectionHeading
      eyebrow="The core loop"
      eyebrow="The core loop"
      title="Insight → Feature → Score → Roadmap → Tasks"
      description="A single trail of evidence that justifies every priority decision."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {features.map(f => <FeatureCard title={f.title} description={f.description} />)}
    </div>
  </section>

  <!-- Workflow preview -->
  <section class="container py-20">
    <SectionHeading
      eyebrow="Demo flow"
      title="From a customer request to a critical-path task"
      description="What the 36-hour demo will show, end to end."
    />
    <div class="glass rounded-2xl p-8 sm:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <h3 class="text-2xl font-bold text-white mb-4">A support user submits three requests</h3>
          <div class="bg-ink-900/60 rounded-lg p-4 font-mono text-sm text-gray-300 mb-6">
            "Customers Acme ($120k ARR) and Globex ($90k ARR) both need bulk export. Initech ($15k) needs SSO."
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">The PM triages and the score changes</h3>
          <ul class="space-y-2 text-gray-300">
            <li class="flex items-start gap-2"><span class="text-brand-400">✓</span> Bulk export: 2 customers, $210k ARR, top of ranked backlog</li>
            <li class="flex items-start gap-2"><span class="text-brand-400">✓</span> SSO: 1 customer, $15k ARR, lower priority but still visible</li>
            <li class="flex items-start gap-2"><span class="text-brand-400">✓</span> Drag bulk export onto next release — conflict check runs</li>
            <li class="flex items-start gap-2"><span class="text-brand-400">✓</span> Five tasks created with dependencies, critical path shown</li>
          </ul>
        </div>
        <div class="relative">
          <div class="absolute inset-0 gradient-bg opacity-20 blur-3xl"></div>
          <div class="relative glass rounded-xl p-6 space-y-3">
            <div class="flex items-center gap-3 p-3 bg-ink-900/60 rounded-lg">
              <div class="w-2 h-2 rounded-full bg-green-400"></div>
              <span class="text-sm text-gray-300">Insight: Bulk export (Acme + Globex, $210k)</span>
            </div>
            <div class="flex items-center gap-3 p-3 bg-ink-900/60 rounded-lg">
              <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
              <span class="text-sm text-gray-300">Feature: Bulk export — score 84, ranked #1</span>
            </div>
            <div class="flex items-start gap-3 p-3 bg-ink-900/60 rounded-lg">
              <div class="w-2 h-2 rounded-full bg-brand-400 mt-1"></div>
              <span class="text-sm text-gray-300">Roadmap: Q2 release · 5 tasks · critical path 14d</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="container py-20">
    <SectionHeading
      eyebrow="Why teams adopt this"
      title="A planning layer the rest of the stack can rely on"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map(t => <Testimonial quote={t.quote} author={t.author} role={t.role} />)}
    </div>
  </section>

  <!-- FAQ -->
  <section class="container py-20">
    <SectionHeading
      eyebrow="FAQ"
      title="Common questions"
    />
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map(f => (
        <FAQ question={f.q}>{f.a}</FAQ>
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>