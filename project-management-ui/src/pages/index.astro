---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const trustedBy = ['Acme', 'Globex', 'Initech', 'Umbrella', 'Stark', 'Wayne'];

const features = [
  { title: 'Insight intake', description: 'Capture verbatim customer feedback with source, customer, segment and contract value — file it unlinked and triage later.' },
  { title: 'Insight-to-feature linking', description: 'One insight, many features. Each feature surfaces the customers and contract value behind it, so priority has an evidence trail.' },
  { title: 'Configurable scoring', description: 'RICE-style scoring with editable weights. Change a weight and the whole backlog re-ranks live — formula and contribution shown, not hidden.' },
  { title: 'Roadmap with dependencies', description: 'Drag features across releases on a timeline. Dependent items flag conflicts instead of silently shifting.' },
  { title: 'Kanban with WIP limits', description: 'Configurable columns mapped to statuses. Drag between columns, with a visible warning when work-in-progress limits are exceeded.' },
  { title: 'Tasks and critical path', description: 'Break features into tasks with assignees, dates and finish-to-start dependencies. The dependency view surfaces the critical path.' },
];

const testimonials = [
  { quote: 'We finally answer "why is this on the roadmap" with evidence instead of opinion.', author: 'Sarah Chen', role: 'Product Manager, Acme' },
  { quote: 'Bulk export to CSV and a Gantt that actually shows blockers — the planning layer our team was missing.', author: 'Marcus Johnson', role: 'Engineering Lead, Globex' },
  { quote: 'Two product managers, one board, zero refresh. The realtime sync changed how we plan.', author: 'Priya Patel', role: 'Head of Product, Initech' },
];

const faqs = [
  { q: 'What does this product replace?', a: 'It replaces the spreadsheet-plus-deck-plus-issue-tracker stack: customer input, prioritization, roadmap and tasks in one place, linked.' },
  { q: 'How does scoring work?', a: 'You define factors (reach, impact, confidence, effort) with weights. Score is computed from named inputs, shown on every feature, and re-ranks live when you change a weight.' },
  { q: 'What is the bulk export for?', a: 'Export the backlog, scoring inputs, roadmap or tasks to CSV for sharing offline or feeding into other tools. Useful for board updates and audits.' },
  { q: 'Can a viewer role really not mutate data?', a: 'Viewer permissions are enforced on the API, not just the UI. Anyone with the role gets read-only access end-to-end.' },
];
---
<BaseLayout title="Project Management Software — Connect customer input to a roadmap">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="container py-20 sm:py-32 relative">
      <div class="max-w-4xl mx-auto text-center animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-400 text-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse-slow"></span>
          BoldCreate Hackathon 2026
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          Product planning that <span class="gradient-text">connects the dots</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          Customer input → roadmap → delivered work, in one tool. No more three disconnected apps and a spreadsheet arguing with each other.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/features" class="btn-primary">See the requirements</a>
          <a href="/how-it-works" class="btn-secondary">Walk through the flow</a>
        </div>
        <p class="text-sm text-gray-500">Insight capture · Configurable scoring · Realtime board · Gantt dependency view</p>
      </div>
    </div>
  </section>

  <!-- Trusted by -->
  <section class="py-12 border-y border-ink-700/50">
    <div class="container">
      <p class="text-center text-sm text-gray-500 mb-8">Designed for product teams like</p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        {trustedBy.map(name => (
          <span class="text-2xl font-bold text-gray-600 hover:text-gray-400 transition-colors">{name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature highlights -->
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="Capabilities" title="One product, four planning layers" subtitle="Insight, Feature, Roadmap, Task — each linked to the next, so evidence flows up and work flows down." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {features.map(f => <FeatureCard title={f.title} description={f.description} />)}
      </div>
    </div>
  </section>

  <!-- Workflow preview -->
  <section class="py-20 bg-ink-800/30">
    <div class="container">
      <SectionHeading eyebrow="The flow" title="From a customer request to a shipped feature" />
      <div class="mt-12 max-w-4xl mx-auto">
        <ol class="space-y-6">
          {[
            { n: 1, t: 'Capture an insight', d: 'Support logs a verbatim customer request with customer name, segment and contract value.' },
            { n: 2, t: 'Link to a feature', d: 'The PM triages it into the backlog, linking it to one or more features. The feature now carries that customer and revenue.' },
            { n: 3, t: 'Score and rank', d: 'Configurable RICE-style scoring ranks the backlog live. The feature rises because real customers are behind it.' },
            { n: 4, t: 'Place on the roadmap', d: 'Drag it onto the next release. Conflicting dependencies flag rather than silently shifting.' },
            { n: 5, t: 'Break into tasks', d: 'Tasks with assignees, dates and finish-to-start dependencies. Gantt view shows the critical path.' },
          ].map(step => (
            <li class="flex gap-4 items-start">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-accent flex items-center justify-center text-white font-bold">{step.n}</span>
              <div>
                <h3 class="text-lg font-semibold text-white mb-1">{step.t}</h3>
                <p class="text-gray-400">{step.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="Why teams pick it" title="Built around the planning gap" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {testimonials.map(t => <Testimonial quote={t.quote} author={t.author} role={t.role} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-ink-800/30">
    <div class="container max-w-3xl">
      <SectionHeading eyebrow="FAQ" title="Common questions" />
      <div class="mt-12 space-y-3">
        {faqs.map(item => <FAQ q={item.q} a={item.a} />)}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>