---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';

const tiers = [
  {
    name: 'Contributor',
    monthly: 0,
    annual: 0,
    blurb: 'For sales and support who submit customer requests.',
    features: ['Submit insights', 'Public request portal', 'Read-only roadmap', 'Email notifications'],
    cta: 'Sign up free',
    highlight: false,
  },
  {
    name: 'Product Manager',
    monthly: 29,
    annual: 24,
    blurb: 'Full edit access — triage, score, roadmap and tasks.',
    features: ['Everything in Contributor', 'Feature backlog & scoring', 'Roadmap timeline & board', 'Task breakdown & dependencies', 'Real-time collaboration', 'Search & activity history'],
    cta: 'Start free trial',
    highlight: true,
  },
  {
    name: 'Enterprise',
    monthly: 99,
    annual: 79,
    blurb: 'SSO, audit trail, capacity planning and dedicated support.',
    features: ['Everything in PM', 'SSO / SAML', 'Capacity planning', 'Public release notes', 'Custom roles', 'Dedicated support'],
    cta: 'Talk to sales',
    highlight: false,
  },
];
---
<BaseLayout title="Pricing — Project Management Software">
  <section class="container py-20">
    <SectionHeading
      eyebrow="Pricing"
      title="Simple pricing for a planning layer your whole org can use"
      description="Three roles. Three tiers. Toggle monthly or annual."
    />

    <div class="flex justify-center mb-10">
      <div class="inline-flex rounded-full border border-ink-700/50 p-1 bg-ink-900/60">
        <button id="bill-monthly" class="px-5 py-2 rounded-full bg-brand-500 text-white text-sm font-medium">Monthly</button>
        <button id="bill-annual" class="px-5 py-2 rounded-full text-gray-400 text-sm font-medium">Annual <span class="text-xs text-brand-400">−20%</span></button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {tiers.map(tier => (
        <div class={tier.highlight
          ? 'glass rounded-2xl p-8 border-2 border-brand-500 relative'
          : 'glass rounded-2xl p-8'}>
          {tier.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-gradient-to-r from-brand-500 to-accent text-white text-xs font-semibold uppercase tracking-wider">
              Most popular
            </div>
          )}
          <h3 class="text-xl font-bold text-white mb-2">{tier.name}</h3>
          <p class="text-gray-400 text-sm mb-6">{tier.blurb}</p>
          <div class="mb-6">
            <span class="text-4xl font-bold text-white">$<span data-monthly={tier.monthly} data-annual={tier.annual}>{tier.monthly}</span></span>
            <span class="text-gray-500">/seat/mo</span>
          </div>
          <ul class="space-y-2 mb-8">
            {tier.features.map(f => (
              <li class="flex items-start gap-2 text-sm text-gray-300">
                <span class="text-brand-400">✓</span>{f}
              </li>
            ))}
          </ul>
          <a href="/contact" class={tier.highlight ? 'btn-primary w-full text-center block' : 'btn-secondary w-full text-center block'}>
            {tier.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>

<script>
  const monthlyBtn = document.getElementById('bill-monthly');
  const annualBtn = document.getElementById('bill-annual');
  const prices = document.querySelectorAll('[data-monthly]');
  function setMode(mode: 'monthly' | 'annual') {
    prices.forEach(el => {
      const v = mode === 'monthly' ? el.getAttribute('data-monthly') : el.getAttribute('data-annual');
      if (v) el.textContent = v;
    });
    monthlyBtn?.classList.toggle('bg-brand-500', mode === 'monthly');
    monthlyBtn?.classList.toggle('text-white', mode === 'monthly');
    annualBtn?.classList.toggle('bg-brand-500', mode === 'annual');
    annualBtn?.classList.toggle('text-white', mode === 'annual');
  }
  monthlyBtn?.addEventListener('click', () => setMode('monthly'));
  annualBtn?.addEventListener('click', () => setMode('annual'));
</script>