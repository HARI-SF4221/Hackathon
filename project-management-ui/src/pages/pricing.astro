---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';

const tiers = [
  {
    name: 'Starter',
    monthly: 0,
    annual: 0,
    blurb: 'Solo product managers trying the workflow on a real backlog.',
    features: [
      'Up to 3 users',
      'Up to 100 features',
      'Insight capture and linking',
      'Configurable scoring (RICE)',
      'Roadmap and board view',
      'CSV bulk export',
    ],
    cta: 'Start free',
    highlighted: false,
  },
  {
    name: 'Pro',
    monthly: 19,
    annual: 15,
    blurb: 'Product teams who run the demo flow end-to-end, with realtime sync.',
    features: [
      'Unlimited users',
      'Unlimited features and tasks',
      'Realtime board sync (SignalR)',
      'Task dependencies and Gantt view',
      'Search across insights, features and tasks',
      'Bulk export and audit history',
      'Three roles: Contributor, PM, Viewer',
    ],
    cta: 'Start 14-day trial',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    monthly: 49,
    annual: 39,
    blurb: 'Larger orgs who need SSO, audit retention and capacity planning.',
    features: [
      'Everything in Pro',
      'SSO and SCIM',
      'Public request portal and upvoting',
      'Capacity planning (effort vs team capacity)',
      'Release notes generated from delivered features',
      'Notification digests',
      'SLA and priority support',
    ],
    cta: 'Contact sales',
    highlighted: false,
  },
];
---
<BaseLayout title="Pricing — Project Management Software">
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="Pricing" title="Three tiers, monthly or annual" subtitle="Toggle below — annual saves roughly 20%." />

      <div class="flex justify-center mt-8 mb-12">
        <div class="inline-flex items-center gap-1 p-1 rounded-full bg-ink-800 border border-ink-700">
          <button id="monthlyBtn" class="px-5 py-2 rounded-full text-sm font-medium bg-brand-500 text-white transition">Monthly</button>
          <button id="annualBtn" class="px-5 py-2 rounded-full text-sm font-medium text-gray-400 hover:text-white transition">Annual <span class="text-xs text-brand-400">-20%</span></button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {tiers.map(tier => (
          <div class={`glass-card p-8 relative ${tier.highlighted ? 'border-brand-500 ring-1 ring-brand-500/40' : ''}`}>
            {tier.highlighted && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-gradient-to-r from-brand-500 to-accent text-xs font-semibold text-white">
                Most popular
              </div>
            )}
            <h3 class="text-2xl font-bold text-white mb-2">{tier.name}</h3>
            <p class="text-gray-400 text-sm mb-6">{tier.blurb}</p>
            <div class="mb-6">
              <span class="text-5xl font-bold text-white price-monthly">${tier.monthly}</span>
              <span class="text-5xl font-bold text-white price-annual hidden">${tier.annual}</span>
              <span class="text-gray-400 ml-2">/ user / month</span>
            </div>
            <a href="/contact" class={`block text-center py-3 rounded-lg font-medium transition mb-6 ${tier.highlighted ? 'btn-primary' : 'btn-secondary'}`}>
              {tier.cta}
            </a>
            <ul class="space-y-3">
              {tier.features.map(f => (
                <li class="flex items-start gap-2 text-sm text-gray-300">
                  <svg class="w-5 h-5 text-brand-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<script>
  const monthlyBtn = document.getElementById('monthlyBtn');
  const annualBtn = document.getElementById('annualBtn');
  const monthlyPrices = document.querySelectorAll('.price-monthly');
  const annualPrices = document.querySelectorAll('.price-annual');

  function setMode(mode) {
    if (mode === 'monthly') {
      monthlyBtn?.classList.add('bg-brand-500', 'text-white');
      monthlyBtn?.classList.remove('text-gray-400');
      annualBtn?.classList.remove('bg-brand-500', 'text-white');
      annualBtn?.classList.add('text-gray-400');
      monthlyPrices.forEach(el => el.classList.remove('hidden'));
      annualPrices.forEach(el => el.classList.add('hidden'));
    } else {
      annualBtn?.classList.add('bg-brand-500', 'text-white');
      annualBtn?.classList.remove('text-gray-400');
      monthlyBtn?.classList.remove('bg-brand-500', 'text-white');
      monthlyBtn?.classList.add('text-gray-400');
      monthlyPrices.forEach(el => el.classList.add('hidden'));
      annualPrices.forEach(el => el.classList.remove('hidden'));
    }
  }

  monthlyBtn?.addEventListener('click', () => setMode('monthly'));
  annualBtn?.addEventListener('click', () => setMode('annual'));
</script>