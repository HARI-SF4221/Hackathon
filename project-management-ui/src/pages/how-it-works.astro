---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';

const steps = [
  {
    n: 1,
    t: 'Capture customer input',
    d: 'Support, sales or PMs log insights as they arrive. Each one carries the verbatim customer text, customer, segment, contract value, source channel and submitter. Filed unlinked when there is no obvious feature yet.',
  },
  {
    n: 2,
    t: 'Triage into the backlog',
    d: 'A product manager reviews the unlinked queue, groups duplicates, and links insights to features. The feature now carries that customer and revenue — the evidence trail that justifies priority.',
  },
  {
    n: 3,
    t: 'Score and rank live',
    d: 'Configurable RICE-style factors with editable weights. Change a weight and the whole backlog re-ranks live. The formula and each factor’s contribution are shown on the feature, not hidden.',
  },
  {
    n: 4,
    t: 'Plan, assign, ship',
    d: 'Top features get placed on the roadmap against a release, then broken into tasks with assignees, dates and finish-to-start dependencies. The Gantt dependency view surfaces the critical path and flags any late predecessor.',
  },
];

const loop = [
  { t: 'A new insight arrives', d: 'Captured unlinked, queued for triage.' },
  { t: 'PM links it to a feature', d: 'Feature gains a customer and contract value.' },
  { t: 'Score recalculates', d: 'Backlog re-ranks live; feature moves up.' },
  { t: 'Feature lands on the roadmap', d: 'Drag onto next release; conflicts flagged.' },
  { t: 'Tasks & dependencies', d: 'Gantt shows critical path; late predecessors surface.' },
];
---
<BaseLayout title="How It Works — Project Management Software">
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="The flow" title="From a customer request to a shipped feature" subtitle="Four steps, one connected pipeline." />
      <div class="mt-16 max-w-4xl mx-auto space-y-8">
        {steps.map(step => (
          <div class="glass-card p-8 flex gap-6">
            <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-brand-500 to-accent flex items-center justify-center text-2xl font-bold text-white">
              {step.n}
            </div>
            <div>
              <h3 class="text-xl font-semibold text-white mb-2">{step.t}</h3>
              <p class="text-gray-400 leading-relaxed">{step.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-ink-800/30">
    <div class="container">
      <SectionHeading eyebrow="Feedback loop" title="Every new insight can change the ranking" />
      <div class="mt-12 max-w-3xl mx-auto">
        <div class="space-y-3">
          {loop.map((l, i) => (
            <div class="glass-card p-5 flex items-center gap-4">
              <span class="text-sm font-mono text-brand-400 w-8">0{i + 1}</span>
              <div>
                <h4 class="text-white font-semibold">{l.t}</h4>
                <p class="text-sm text-gray-400">{l.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container max-w-3xl">
      <SectionHeading eyebrow="Integrations" title="Syncfusion components, end-to-end" />
      <p class="text-gray-400 text-center">
        The board, timeline and Gantt are powered by Syncfusion Kanban, Scheduler and Gantt. Rebuilding what those already ship is a completeness loss under the hackathon rubric, so we use them as the foundation, not decoration.
      </p>
    </div>
  </section>

  <CTA />
</BaseLayout>