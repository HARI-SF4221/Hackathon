---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkflowStep from '../components/WorkflowStep.astro';
import CTA from '../components/CTA.astro';

const steps = [
  {
    n: 1,
    title: 'Capture insights from anywhere',
    body: 'Support, sales and the public portal all feed into one stream. Every insight carries customer, segment, contract value, source and date. Nothing is filed and forgotten.',
  },
  {
    n: 2,
    title: 'Triage and link to features',
    body: 'The PM links each insight to a feature. The feature now carries the evidence: which customers asked, how much revenue they represent, and how many distinct accounts are behind it.',
  },
  {
    n: 3,
    title: 'Score on a transparent formula',
    body: 'Reach, impact, confidence, effort — every factor has a weight, every weight is editable. Changing a weight re-ranks the whole backlog live. No black-box numbers.',
  },
  {
    n: 4,
    title: 'Drop on the roadmap, decompose into tasks',
    body: 'Drag the top feature onto the next release. Break it into tasks with finish-to-start dependencies. The dependency view shows the critical path and flags late predecessors before they slip the date.',
  },
];
---
<BaseLayout title="How It Works — Project Management Software">
  <section class="container py-20">
    <SectionHeading
      eyebrow="The 4-step pipeline"
      title="From customer voice to a critical path"
      description="A closed loop, not a hand-off."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      {steps.map(s => (
        <WorkflowStep number={s.n} title={s.title} description={s.body} />
      ))}
    </div>
  </section>

  <section class="container py-12">
    <div class="glass rounded-2xl p-8 sm:p-12">
      <h2 class="text-2xl font-bold text-white mb-4">The feedback loop</h2>
      <p class="text-gray-300 mb-6 max-w-3xl">
        When a feature ships, the customers behind its insights are notified. When a feature is declined, the reasons are recorded on the insight so the next request of the same shape is triaged with the same context. Nothing drops on the floor.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm text-gray-300">
        <div class="bg-ink-900/60 rounded-lg p-4">
          <div class="text-brand-400 font-mono mb-1">Insight → Feature</div>
          Triage the voice of the customer into a unit of work.
        </div>
        <div class="bg-ink-900/60 rounded-lg p-4">
          <div class="text-brand-400 font-mono mb-1">Feature → Task</div>
          Decompose into assigned work with finish-to-start dependencies.
        </div>
        <div class="bg-ink-900/60 rounded-lg p-4">
          <div class="text-brand-400 font-mono mb-1">Task → Customer</div>
          Notify the requesters when their feature ships or is declined.
        </div>
      </div>
    </div>
  </section>

  <section class="container py-12">
    <h2 class="text-3xl font-bold text-white mb-8">Reuses Syncfusion components — does not rebuild them</h2>
    <p class="text-gray-300 max-w-3xl mb-6">
      The hackathon rubric scores dogfooding as a positive. The Gantt, Kanban and Scheduler are shipped as the board, the dependency view and the roadmap — not rebuilt from scratch.
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {['Gantt', 'Kanban', 'Scheduler', 'Rich Text Editor'].map(name => (
        <div class="glass rounded-lg p-4 text-center">
          <div class="text-brand-400 font-semibold">{name}</div>
        </div>
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>