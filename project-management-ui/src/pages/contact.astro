---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<BaseLayout title="Contact — Project Management Software">
  <section class="py-20">
    <div class="container max-w-5xl">
      <SectionHeading eyebrow="Get in touch" title="Talk to the team" subtitle="Questions about the requirements, the demo or how Syncfusion components are wired in — drop a line." />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-12">
        <!-- Form -->
        <form class="glass-card p-8 space-y-5" action="#" method="post">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Name</label>
            <input id="name" name="name" type="text" required class="w-full px-4 py-2.5 rounded-lg bg-ink-800 border border-ink-700 text-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Work email</label>
            <input id="email" name="email" type="email" required class="w-full px-4 py-2.5 rounded-lg bg-ink-800 border border-ink-700 text-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition" />
          </div>
          <div>
            <label for="team" class="block text-sm font-medium text-gray-300 mb-2">Team size</label>
            <select id="team" name="team" class="w-full px-4 py-2.5 rounded-lg bg-ink-800 border border-ink-700 text-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition">
              <option>1-5</option>
              <option>6-20</option>
              <option>21-100</option>
              <option>100+</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-gray-300 mb-2">How can we help?</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2.5 rounded-lg bg-ink-800 border border-ink-700 text-white focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition resize-none"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Send message</button>
        </form>

        <!-- Channels -->
        <div class="space-y-6">
          <div class="glass-card p-6">
            <h3 class="text-white font-semibold mb-2">Hackathon channel</h3>
            <p class="text-gray-400 text-sm mb-2">For demo questions, judging and integrations:</p>
            <a href="mailto:hackathon@boldcreate.dev" class="text-brand-400 font-mono text-sm">hackathon@boldcreate.dev</a>
          </div>
          <div class="glass-card p-6">
            <h3 class="text-white font-semibold mb-2">Engineering</h3>
            <p class="text-gray-400 text-sm mb-2">For ASP.NET Core / Syncfusion / SignalR questions:</p>
            <a href="mailto:eng@boldcreate.dev" class="text-brand-400 font-mono text-sm">eng@boldcreate.dev</a>
          </div>
          <div class="glass-card p-6">
            <h3 class="text-white font-semibold mb-2">Office</h3>
            <p class="text-gray-400 text-sm">
              BoldCreate HQ<br />
              1 Hackathon Way<br />
              San Francisco, CA 94105
            </p>
          </div>
          <div class="glass-card p-6">
            <h3 class="text-white font-semibold mb-2">Stack reference</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              ASP.NET Core · EF Core · PostgreSQL · SignalR · Hangfire · OpenSearch · Syncfusion (Kanban, Scheduler, Gantt).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>