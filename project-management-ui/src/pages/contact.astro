---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const channels = [
  { title: 'Sales', desc: 'Talk to our sales team about enterprise plans.', cta: 'sales@taskflow.ai' },
  { title: 'Support', desc: 'Get help with your account or technical issues.', cta: 'support@taskflow.ai' },
  { title: 'Partnerships', desc: 'Explore partnership and integration opportunities.', cta: 'partners@taskflow.ai' },
];

const offices = [
  { city: 'San Francisco', address: '548 Market St, CA 94104' },
  { city: 'New York', address: '350 5th Ave, NY 10118' },
  { city: 'London', address: '1 King St, EC2V 8AU' },
];
---
<BaseLayout title="Contact — TaskFlow AI">
  <section class="container py-20">
    <SectionHeading
      eyebrow="Contact"
      title="Get in touch"
      description="Have a question? We'd love to hear from you."
    />
  </section>

  <section class="container pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
      <div>
        <h2 class="text-2xl font-bold text-white mb-6">Send us a message</h2>
        <form class="space-y-4" action="#" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm text-gray-300 mb-2">Name</label>
              <input id="name" name="name" type="text" required class="w-full px-4 py-3 rounded-lg bg-ink-800 border border-ink-700 text-white focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
            </div>
            <div>
              <label for="email" class="block text-sm text-gray-300 mb-2">Email</label>
              <input id="email" name="email" type="email" required class="w-full px-4 py-3 rounded-lg bg-ink-800 border border-ink-700 text-white focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
            </div>
          </div>
          <div>
            <label for="company" class="block text-sm text-gray-300 mb-2">Company</label>
            <input id="company" name="company" type="text" class="w-full px-4 py-3 rounded-lg bg-ink-800 border border-ink-700 text-white focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
          </div>
          <div>
            <label for="message" class="block text-sm text-gray-300 mb-2">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg bg-ink-800 border border-ink-700 text-white focus:ring-2 focus:ring-brand-500 focus:border-transparent"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Send Message</button>
        </form>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-white mb-6">Other ways to reach us</h2>
        <div class="space-y-4">
          {channels.map(c => (
            <div class="glass rounded-xl p-5">
              <h3 class="text-white font-semibold mb-1">{c.title}</h3>
              <p class="text-gray-400 text-sm mb-2">{c.desc}</p>
              <a href={`mailto:${c.cta}`} class="text-brand-400 text-sm hover:text-brand-300">{c.cta}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container py-20">
    <SectionHeading
      eyebrow="Our offices"
      title="Around the world"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {offices.map(o => (
        <div class="glass rounded-xl p-6">
          <h3 class="text-white font-semibold mb-2">{o.city}</h3>
          <p class="text-gray-400 text-sm">{o.address}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>