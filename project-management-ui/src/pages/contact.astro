---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<BaseLayout title="Contact — Project Management Software">
  <section class="container py-20 max-w-5xl">
    <SectionHeading
      eyebrow="Get in touch"
      title="Talk to us about the demo"
      description="Hackathon project · BoldCreate 2026"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
      <div>
        <form class="glass rounded-2xl p-8 space-y-5" onsubmit="event.preventDefault(); alert('Demo submission — form not wired in this scaffold.');">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Name</label>
            <input id="name" name="name" type="text" required class="w-full bg-ink-900/60 border border-ink-700/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
            <input id="email" name="email" type="email" required class="w-full bg-ink-900/60 border border-ink-700/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-500" />
          </div>
          <div>
            <label for="role" class="block text-sm font-medium text-gray-300 mb-2">Your role</label>
            <select id="role" name="role" class="w-full bg-ink-900/60 border border-ink-700/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-500">
              <option>Product Manager</option>
              <option>Engineering Lead</option>
              <option>Sales / Support</option>
              <option>Executive</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label for="msg" class="block text-sm font-medium text-gray-300 mb-2">Message</label>
            <textarea id="msg" name="msg" rows="4" required class="w-full bg-ink-900/60 border border-ink-700/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-500"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Send message</button>
        </form>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-semibold text-white mb-2">Demo channel</h3>
          <p class="text-gray-300">The live demo runs at the public tunnel URL shared with hackathon judges.</p>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-white mb-2">Stack</h3>
          <ul class="text-gray-300 space-y-1 text-sm">
            <li>Backend — ASP.NET Core + EF Core</li>
            <li>Frontend — React + TypeScript</li>
            <li>Database — PostgreSQL</li>
            <li>Realtime — SignalR</li>
            <li>Background jobs — Hangfire</li>
            <li>Search — Elasticsearch / OpenSearch</li>
            <li>UI — Syncfusion Gantt, Kanban, Scheduler</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-white mb-2">Office</h3>
          <p class="text-gray-300">Remote · BoldCreate Hackathon 2026</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>