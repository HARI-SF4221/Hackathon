---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';

const stats = [
  { v: '12', l: 'Numbered requirements' },
  { v: '4', l: 'Linked planning layers' },
  { v: '<1s', l: 'Realtime propagation' },
  { v: '36h', l: 'Built in a hackathon' },
];

const values = [
  { t: 'Evidence over opinion', d: 'Priority should be defensible. Every feature shows the customers and revenue behind it, and the scoring formula is editable and visible.' },
  { t: 'One tool, not three', d: 'Insight, feature, roadmap and task live in the same system and link to each other. No more arguing between a deck, a spreadsheet and an issue tracker.' },
  { t: 'Realtime by default', d: 'Two PMs on the same board see each other’s moves immediately, with deterministic conflict resolution when simultaneous edits happen.' },
  { t: 'Use what already exists', d: 'Syncfusion ships excellent Kanban, Scheduler and Gantt components. We compose them, not rebuild them.' },
];

const team = [
  { name: 'Product', desc: 'Owns the requirements spec and the demo flow.' },
  { name: 'Backend', desc: 'ASP.NET Core + EF Core, Hangfire jobs, SignalR realtime, OpenSearch indexing.' },
  { name: 'Frontend', desc: 'React + TypeScript, Syncfusion components, accessible board and Gantt.' },
];
---
<BaseLayout title="About — Project Management Software">
  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="About" title="Built for BoldCreate Hackathon 2026" subtitle="A planning layer that connects customer input to a roadmap to delivered work, instead of three disconnected tools and a spreadsheet." />

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16">
        {stats.map(s => (
          <div class="glass-card p-6 text-center">
            <div class="text-4xl font-bold gradient-text mb-2">{s.v}</div>
            <div class="text-sm text-gray-400">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-ink-800/30">
    <div class="container">
      <SectionHeading eyebrow="Mission" title="Make prioritization defensible" />
      <p class="text-gray-300 text-lg leading-relaxed max-w-3xl mx-auto text-center">
        Product teams collect feature requests in one place, argue about priority in a meeting, keep the roadmap in a slide deck, and track the actual work in an issue tracker. Nothing links back. We are fixing that.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container">
      <SectionHeading eyebrow="Values" title="What we optimize for" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12 max-w-4xl mx-auto">
        {values.map(v => (
          <div class="glass-card p-6">
            <h3 class="text-lg font-semibold text-white mb-2">{v.t}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-ink-800/30">
    <div class="container">
      <SectionHeading eyebrow="Team" title="Roles in this build" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {team.map(m => (
          <div class="glass-card p-6 text-center">
            <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-brand-500 to-accent flex items-center justify-center text-white text-xl font-bold mb-4">
              {m.name[0]}
            </div>
            <h3 class="text-white font-semibold mb-2">{m.name}</h3>
            <p class="text-sm text-gray-400">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>