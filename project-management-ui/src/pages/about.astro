---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';

const stats = [
  { value: '36h', label: 'hackathon window' },
  { value: '12', label: 'features in 4 groups' },
  { value: '3', label: 'user roles' },
  { value: '4', label: 'core data entities' },
];

const values = [
  { title: 'Evidence over opinion', body: 'Every priority decision shows the customer evidence behind it — the requester, the segment, the contract value.' },
  { title: 'Closed loops, not handoffs', body: 'Insight to feature to task to ship, then back to the customer. Nothing drops on the floor.' },
  { title: 'Reuse what already exists', body: 'Syncfusion Gantt, Kanban and Scheduler are dogfooded. Rebuilding them is a completeness loss under the rubric.' },
  { title: 'Sub-second is the floor', body: 'Real-time sync, instant re-rank, search under a second on the demo dataset. Slow tools stop being used.' },
];

const team = [
  { name: 'Product', role: 'Triage, score, roadmap' },
  { name: 'Engineering', role: 'Backend, frontend, real-time' },
  { name: 'Design', role: 'Syncfusion dogfooding, a11y' },
];
---
<BaseLayout title="About — Project Management Software">
  <section class="container py-20">
    <SectionHeading
      eyebrow="About the project"
      title="Closing the loop between what customers ask for and what actually ships"
      description="A hackathon build that puts planning on the same evidence trail as execution."
    />
  </section>

  <section class="container py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map(s => (
        <div class="glass rounded-xl p-6 text-center">
          <div class="text-4xl font-bold gradient-text mb-2">{s.value}</div>
          <div class="text-sm text-gray-400 uppercase tracking-wider">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {values.map(v => (
        <div class="glass rounded-xl p-8">
          <h3 class="text-xl font-bold text-white mb-3">{v.title}</h3>
          <p class="text-gray-300">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container py-12">
    <h2 class="text-3xl font-bold text-white mb-8 text-center">The team</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {team.map(m => (
        <div class="glass rounded-xl p-6 text-center">
          <div class="w-20 h-20 rounded-full mx-auto mb-4 bg-gradient-to-br from-brand-500 to-accent flex items-center justify-center text-2xl font-bold text-white">
            {m.name[0]}
          </div>
          <div class="text-lg font-semibold text-white">{m.name}</div>
          <div class="text-sm text-gray-400">{m.role}</div>
        </div>
      ))}
    </div>
  </section>

  <CTA />
</BaseLayout>